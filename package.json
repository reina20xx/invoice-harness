{
  "name": "ec-harness",
  "version": "0.1.0",
  "description": "Zero-cost, AI-native EC CRM & Abandoned Cart Recovery Engine for Shopify/BASE powered by Cloudflare Workers & D1",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx src/dev-server.ts",
    "dev:wrangler": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute ec-crm-db --local --file=./schema.sql",
    "d1:remote": "wrangler d1 execute ec-crm-db --remote --file=./schema.sql"
  },
  "keywords": [
    "shopify",
    "base",
    "ec",
    "crm",
    "abandoned-cart",
    "line",
    "resend",
    "cloudflare-workers",
    "d1",
    "mcp"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
